PORT=3000
DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4200
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini
SEED_ADMIN_EMAIL=admin@chanchamayo.local
SEED_ADMIN_PASSWORD=
# Consulta DNI/RUC de api.apis.net.pe. El token va solo en backend/.env.
# Ambas URL deben incluir el marcador {documento}. Se envía como Authorization: Bearer.
DNI_API_URL=https://api.apis.net.pe/v2/reniec/dni?numero={documento}
RUC_API_URL=https://api.apis.net.pe/v2/sunat/ruc?numero={documento}
DNI_API_TOKEN=
